FROM docker:27-cli AS dockercli

FROM maven:3.9.12-eclipse-temurin-25 AS build

WORKDIR /workspace

COPY pom.xml ./pom.xml
COPY checkstyle.xml checkstyle-suppressions.xml ./
COPY backend-core/pom.xml backend-core/pom.xml
COPY backend-plagscan/pom.xml backend-plagscan/pom.xml

RUN mvn -pl backend-core -am dependency:go-offline -DskipTests

COPY backend-core/src backend-core/src

RUN mvn -pl backend-core -am clean package -DskipTests

FROM eclipse-temurin:25-jre

ENV LANGUAGE='en_US:en'

WORKDIR /deployments

USER root

COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
RUN docker --version

COPY --from=build --chown=185 /workspace/backend-core/target/quarkus-app/lib/ /deployments/lib/
COPY --from=build --chown=185 /workspace/backend-core/target/quarkus-app/*.jar /deployments/
COPY --from=build --chown=185 /workspace/backend-core/target/quarkus-app/app/ /deployments/app/
COPY --from=build --chown=185 /workspace/backend-core/target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185

ENTRYPOINT ["java", "-Dquarkus.http.host=0.0.0.0", "-Djava.util.logging.manager=org.jboss.logmanager.LogManager", "-jar", "/deployments/quarkus-run.jar"]
