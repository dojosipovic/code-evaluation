<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <!-- TASK TABLE -->
    <changeSet id="004-create-task-table" author="dominik">
        <createTable tableName="task">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="title" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="starter_code" type="TEXT"/>

            <column name="enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>

            <column name="shared" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="task"
                baseColumnNames="user_id"
                constraintName="fk_task_user"
                referencedTableName="app_user"
                referencedColumnNames="id"/>
    </changeSet>


    <!-- TASK_TEST TABLE -->
    <changeSet id="004-create-task-test-table" author="dominik">
        <createTable tableName="task_test">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="input" type="VARCHAR(200)"/>

            <column name="output" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>

            <column name="visibility" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="task_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="task_test"
                baseColumnNames="task_id"
                constraintName="fk_task_test_task"
                referencedTableName="task"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>


    <changeSet id="004-add-task-status-to-task" author="dominik">
        <addColumn tableName="task">
            <column name="status" type="VARCHAR(32)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
