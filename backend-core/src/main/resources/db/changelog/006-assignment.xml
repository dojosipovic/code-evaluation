<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="006-create-assignment-table" author="dominik">
        <createTable tableName="assignment">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>

            <column name="starts_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <column name="ends_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <column name="points" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="task_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="group_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="assignment"
                baseColumnNames="task_id"
                constraintName="fk_assignment_task"
                referencedTableName="task"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="assignment"
                baseColumnNames="group_id"
                constraintName="fk_assignment_group"
                referencedTableName="groups"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="assignment"
                baseColumnNames="user_id"
                constraintName="fk_assignment_user"
                referencedTableName="app_user"
                referencedColumnNames="id"/>

        <createIndex
                indexName="idx_assignment_group_id"
                tableName="assignment">
            <column name="group_id"/>
        </createIndex>

        <createIndex
                indexName="idx_assignment_task_id"
                tableName="assignment">
            <column name="task_id"/>
        </createIndex>

        <createIndex
                indexName="idx_assignment_user_id"
                tableName="assignment">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
